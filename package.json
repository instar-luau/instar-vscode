{
  "name": "instar",
  "displayName": "Instar",
  "version": "0.1.1",
  "private": true,
  "description": "Luau language support powered by Instar.",
  "categories": [
    "Formatters",
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "instar"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/instar-luau/instar-vscode.git"
  },
  "publisher": "Instar",
  "files": [
    "dist/extension.cjs",
    "dist/extension.cjs.map",
    "dist/grammar.json",
    "dist/LICENSE",
    "icons/**",
    "language.json",
    "server/**",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "typecheck": "tsc && tsc --project src",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "bun run typecheck && bun run lint && bun run format --check",
    "build": "bun scripts/build.ts",
    "server": "bun scripts/server.ts",
    "package": "bun scripts/package.ts",
    "test": "bun test"
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "@tooling/node": "npm:@types/node@26.6.5",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "4.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "textmate-luau": "github:instar-luau/textmate-luau"
  },
  "contributes": {
    "languages": [
      {
        "id": "luau",
        "aliases": [
          "Luau"
        ],
        "extensions": [
          ".luau"
        ],
        "configuration": "./language.json",
        "icon": {
          "light": "./icons/light.svg",
          "dark": "./icons/dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "luau",
        "scopeName": "source.luau",
        "path": "./dist/grammar.json",
        "unbalancedBracketScopes": [
          "keyword.operator.comparison",
          "keyword.operator.type.function"
        ],
        "tokenTypes": {
          "meta.template.expression": "other",
          "meta.template.expression string": "string",
          "meta.template.expression comment": "comment"
        }
      }
    ],
    "configurationDefaults": {
      "[luau]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "commands": [
      {
        "command": "instar.restart",
        "title": "Restart Language Server",
        "category": "Instar"
      },
      {
        "command": "instar.stop",
        "title": "Stop Language Server",
        "category": "Instar"
      },
      {
        "command": "instar.output",
        "title": "Show Output",
        "category": "Instar"
      }
    ],
    "configuration": {
      "title": "Instar",
      "properties": {
        "instar.executable": {
          "type": "string",
          "scope": "machine",
          "description": "Absolute path to an Instar executable. Leave empty to use bundled Instar. Reload the window after changing this setting."
        },
        "instar.diagnostic_scope": {
          "type": "string",
          "enum": [
            "open_files",
            "workspace"
          ],
          "default": "open_files",
          "scope": "resource",
          "description": "Files for which Instar publishes diagnostics."
        },
        "instar.completion_snippets": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Include snippets in completions."
        },
        "instar.import.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Suggest imports in completions."
        },
        "instar.import.require": {
          "type": "string",
          "enum": [
            "string",
            "instance"
          ],
          "default": "string",
          "scope": "resource",
          "description": "Use string paths or Roblox instance paths for suggested imports."
        },
        "instar.import.binding": {
          "type": "string",
          "enum": [
            "local",
            "const"
          ],
          "default": "local",
          "scope": "resource",
          "description": "Declaration keyword for suggested imports."
        },
        "instar.import.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "scope": "resource",
          "description": "Workspace-relative glob patterns for import suggestions. An empty list includes all modules."
        },
        "instar.import.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "scope": "resource",
          "description": "Workspace-relative glob patterns excluded from import suggestions."
        },
        "instar.hints.variable_types": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show inferred variable type hints."
        },
        "instar.hints.parameter_names": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show parameter name hints at call sites."
        },
        "instar.hints.return_types": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Show inferred function return type hints."
        },
        "instar.hints.hide_obvious": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Hide hints that are evident from the surrounding code."
        }
      }
    }
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Instar can execute sourcemap generators defined by project configuration."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Instar requires access to files on the workspace host."
    }
  }
}
